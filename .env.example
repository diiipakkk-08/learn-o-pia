# Environment Variables for Learn-o-pia
# Copy this file to .env and fill in your actual values

# --- Supabase (REQUIRED for database & login to work) ---
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://qwtjeusllzpuncvcmck.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# --- Google OAuth (OPTIONAL - for Google Sign-In button) ---
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
